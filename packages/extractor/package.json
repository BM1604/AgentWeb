{
  "name": "@agentweb/extractor",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentweb/core": "workspace:*",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
